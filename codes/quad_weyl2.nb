Cell[BoxData[{
 RowBox[{
  RowBox[{"lim", "=", "\[Pi]"}], ";", 
  RowBox[{"mu", "=", "0.5"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ar1", "=", 
   RowBox[{"Quiet", "[", 
    RowBox[{"ContourPlot", "[", 
     RowBox[{
      RowBox[{
       FractionBox[
        RowBox[{
         SqrtBox["3"], " ", "kz", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
