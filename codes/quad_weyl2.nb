Cell[BoxData[{
 RowBox[{
  RowBox[{"$PrePrint", "=", 
   RowBox[{
    RowBox[{"#", "/.", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"Csc", "[", "z_", "]"}], ":>", 
        RowBox[{"1", "/", 
         RowBox[{"Defer", "@", 
          RowBox[{"Sin", "[", "z", "]"}]}]}]}], ",", 
       RowBox[{
        RowBox[{"Sec", "[", "z_", "]"}], ":>", 
        RowBox[{"1", "/", 
         RowBox[{"Defer", "@", 
          RowBox[{"Cos", "[", "z", "]"}]}]}]}]}], "}"}]}], "&"}]}], ";", 
  RowBox[{"Clear", "[", "\[Kappa]", "]"}], ";", 
  RowBox[{"rep", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a1", "->", 
      SubscriptBox["a", "1"]}], ",", 
     RowBox[{"\[Kappa]i", "->", 
      SubscriptBox["\[Kappa]", "i"]}], ",", 
     RowBox[{"\[Kappa]r", "->", 
      SubscriptBox["\[Kappa]", "r"]}], ",", 
     RowBox[{"kx", "->", 
      SubscriptBox["k", "x"]}], ",", " ", 
     RowBox[{"ky", "->", 
      SubscriptBox["k", "y"]}], ",", " ", 
     RowBox[{"kz", "->", 
      SubscriptBox["k", "z"]}], ",", " ", 
     RowBox[{"vz", "->", 
      SubscriptBox["v", "z"]}], ",", " ", 
     RowBox[{"vp", "->", 
      SubscriptBox["v", "p"]}], ",", 
     RowBox[{"en", "->", "e"}], ",", 
     RowBox[{"b1", "->", 
      SubscriptBox["b", "1"]}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ass", "=", 
   RowBox[{"Assumptions", "->", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "en", ",", "k", ",", "\[Theta]", ",", "v", ",", "kx", ",", "ky", ",", 
        "kz", ",", "\[Kappa]r", ",", "\[Kappa]i", ",", "k1", ",", "k2", ",", 
        "kw"}], "}"}], "\[Element]", " ", "Reals"}], " ", "&&", "  ", 
     RowBox[{"k", ">", "0"}], " ", "&&", " ", 
     RowBox[{"kp", ">", "0"}], " ", "&&", " ", 
     RowBox[{"en", ">=", "0"}], " ", "&&", " ", 
