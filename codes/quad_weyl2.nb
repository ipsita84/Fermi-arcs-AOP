           SuperscriptBox["kz", "2"]}], ")"}]}], 
        SqrtBox[
         RowBox[{"1", "+", 
          RowBox[{"3", " ", 
           SuperscriptBox["kz", "2"]}]}]]], "==", "mu"}], ",", 
      RowBox[{"{", 
       RowBox[{"k1", ",", 
        RowBox[{
         RowBox[{"-", 
          SqrtBox["2"]}], "lim"}], ",", 
        RowBox[{
         SqrtBox["2"], "lim"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"kz", ",", 
        RowBox[{"-", "lim"}], ",", "lim"}], "}"}], ",", 
      RowBox[{"ContourStyle", "->", "Red"}], ",", 
      RowBox[{"RegionFunction", "\[Rule]", 
       RowBox[{"Function", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"k1", ",", "kz", ",", "z"}], "}"}], ",", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"-", 
               SqrtBox["3"]}], " ", "k1"}], "-", 
             SqrtBox[
              RowBox[{
               RowBox[{"-", 
                SuperscriptBox["kz", "2"]}], "+", 
               RowBox[{
                SuperscriptBox["k1", "2"], " ", 
                RowBox[{"(", 
                 RowBox[{"4", "-", 
                  RowBox[{"3", " ", 
                   SuperscriptBox["kz", "2"]}]}], ")"}]}]}]]}], ">", "0"}], 
           "  ", ")"}], "&&", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"-", 
             SuperscriptBox["kz", "2"]}], "+", 
            RowBox[{
             SuperscriptBox["k1", "2"], " ", 
             RowBox[{"(", 
              RowBox[{"4", "-", 
               RowBox[{"3", " ", 
                SuperscriptBox["kz", "2"]}]}], ")"}]}]}], ">=", "0"}]}]}], 
        "]"}]}], ",", 
      RowBox[{"PlotLegends", "->", "Automatic"}], ",", 
      RowBox[{"Contours", "->", "10"}]}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
