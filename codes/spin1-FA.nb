Cell[CellGroupData[{

Cell["numerical solns", "Section",
 CellChangeTimes->{
  3.9696219369755077`*^9},ExpressionUUID->"1e8683de-a2ff-45ff-b06f-\
7fa4a63bfc9b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "daty", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"daty", "[", 
   RowBox[{"\[Mu]_", ",", "pts_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"\[Kappa]r", ",", "t", ",", 
      RowBox[{"\[Kappa]i", "=", "0"}], ",", "ky", ",", "kz", ",", "eq0", ",", 
      "kx", ",", "eqn", ",", 
      RowBox[{"en", "=", "\[Mu]"}], ",", "a1", ",", "a2", ",", "b1", ",", 
      "b2", ",", 
      RowBox[{"del", "=", 
       RowBox[{"2", 
        RowBox[{"\[Pi]", "/", "pts"}]}]}], ",", "i", ",", "j", ",", 
      RowBox[{"dat", "=", 
       RowBox[{"{", "}"}]}], ",", "sol", ",", "len"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"eq0", "=", 
      RowBox[{
       SuperscriptBox["b1", "2"], "+", 
       SuperscriptBox["b2", "2"], "-", "1"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"b1", "=", 
        RowBox[{"Sin", "[", "t", "]"}]}], ";", 
       RowBox[{"b2", "=", 
        RowBox[{"Cos", "[", "t", "]"}]}], ";"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"eqn", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"-", "2"}], " ", "en"}], "+", 
         RowBox[{
          SqrtBox["2"], " ", "a1", " ", "kx"}], "+", 
         RowBox[{
          SqrtBox["2"], " ", "a2", " ", "ky"}], "-", 
         RowBox[{"2", " ", "\[Kappa]i"}]}], ",", 
        RowBox[{
         RowBox[{
          SqrtBox["2"], " ", "a2", " ", "kx"}], "-", 
         RowBox[{
          SqrtBox["2"], " ", "a1", " ", "ky"}], "+", 
         RowBox[{"2", " ", "\[Kappa]r"}]}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "2"}], " ", "a1", " ", "en"}], "+", 
         RowBox[{
          SqrtBox["2"], " ", 
          RowBox[{"(", 
           RowBox[{"kx", "+", 
            RowBox[{"b1", " ", "kx"}], "+", 
            RowBox[{"b2", " ", "ky"}]}], ")"}]}]}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "2"}], " ", "a2", " ", "en"}], "+", 
         RowBox[{
          SqrtBox["2"], " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"b2", " ", "kx"}], "+", "ky", "-", 
            RowBox[{"b1", " ", "ky"}]}], ")"}]}]}], ",", 
        RowBox[{
         RowBox[{
          SqrtBox["2"], " ", "a1", " ", "kx"}], "-", 
         RowBox[{
          SqrtBox["2"], " ", "a2", " ", "ky"}], "+", 
         RowBox[{"2", " ", "b1", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "en"}], "+", "\[Kappa]i"}], ")"}]}], "+", 
         RowBox[{"2", " ", "b2", " ", "\[Kappa]r"}]}], ",", 
        RowBox[{
         RowBox[{
          SqrtBox["2"], " ", "a2", " ", "kx"}], "+", 
         RowBox[{
          SqrtBox["2"], " ", "a1", " ", "ky"}], "+", 
         RowBox[{"2", " ", "b2", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "en"}], "+", "\[Kappa]i"}], ")"}]}], "-", 
         RowBox[{"2", " ", "b1", " ", "\[Kappa]r"}]}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"For", "[", 
      RowBox[{"(*", "*)"}], 
      RowBox[{
       RowBox[{"i", "=", "0"}], ",", 
       RowBox[{"i", "<=", "pts"}], ",", 
       RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"ky", "=", 
         RowBox[{"0", "+", 
          RowBox[{"i", " ", "del"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"sol", "=", 
         RowBox[{"Chop", "[", 
          RowBox[{
           RowBox[{"Quiet", "[", 
            RowBox[{"NSolveValues", "[", " ", 
             RowBox[{
              RowBox[{
               RowBox[{"eq0", "==", "0"}], " ", "&&", " ", 
               RowBox[{
                RowBox[{"eqn", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], "==", "0"}], " ", "&&", " ", 
               RowBox[{
                RowBox[{"eqn", "[", 
                 RowBox[{"[", "2", "]"}], "]"}], "==", "0"}], " ", "&&", " ", 
               RowBox[{
                RowBox[{"eqn", "[", 
                 RowBox[{"[", "3", "]"}], "]"}], "==", "0"}], " ", "&&", " ", 
               RowBox[{
                RowBox[{"eqn", "[", 
                 RowBox[{"[", "4", "]"}], "]"}], "==", "0"}], " ", "&&", " ", 
               RowBox[{
                RowBox[{"eqn", "[", 
                 RowBox[{"[", "5", "]"}], "]"}], "==", "0"}], " ", "&&", " ", 
               RowBox[{
                RowBox[{"eqn", "[", 
                 RowBox[{"[", "6", "]"}], "]"}], "==", "0"}], " ", "&&", " ", 
               RowBox[{
                RowBox[{"Re", "[", "\[Kappa]r", "]"}], ">", "0"}], " ", "&&", 
               "  ", 
               RowBox[{
                RowBox[{"Abs", "[", 
                 RowBox[{"Im", "[", "\[Kappa]r", "]"}], "]"}], "<", 
                SuperscriptBox["10", 
                 RowBox[{"-", "6"}]]}]}], ",", 
              RowBox[{"{", 
               RowBox[{
               "kx", ",", "\[Kappa]r", ",", "a1", ",", "a2", ",", "b1", ",", 
                "b2"}], "}"}], ",", "Reals"}], "]"}], "]"}], ",", 
           SuperscriptBox["10", 
            RowBox[{"-", "6"}]]}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"len", "=", 
         RowBox[{"Length", "[", "sol", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{"accumulation", " ", "kx", " ", "values"}], " ", "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"For", "[", 
         RowBox[{
          RowBox[{"j", "=", "1"}], ",", 
          RowBox[{"j", "<=", "len"}], ",", 
          RowBox[{"j", "++"}], ",", 
          RowBox[{"dat", "=", 
           RowBox[{"AppendTo", "[", 
            RowBox[{"dat", ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"sol", "[", 
                RowBox[{"[", 
                 RowBox[{"j", ",", "1"}], "]"}], "]"}], ",", "ky"}], "}"}]}], 
            "]"}]}]}], 
         RowBox[{"(*", 
          RowBox[{";", " ", 
           RowBox[{"Print", "[", "\"\<***********\>\"", "]"}]}], "*)"}], 
         "]"}]}]}], "\[IndentingNewLine]", 
      RowBox[{"(*", "*)"}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Sort", "[", "dat", "]"}]}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"daty", "[", 
  RowBox[{"mu", ",", "10"}], "]"}]}], "Input",
 CellChangeTimes->{{3.967894147318191*^9, 3.967894148193966*^9}, {
