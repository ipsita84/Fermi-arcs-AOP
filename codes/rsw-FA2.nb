                 RowBox[{"eqn", "[", 
                  RowBox[{"[", "8", "]"}], "]"}], "==", "0"}], " ", "&&", " ", 
                RowBox[{
                 RowBox[{"Re", "[", "\[Kappa]r", "]"}], ">", "0"}], " ", "&&",
                 "  ", 
                RowBox[{
                 RowBox[{"Abs", "[", 
                  RowBox[{"Im", "[", "\[Kappa]r", "]"}], "]"}], "<", 
                 SuperscriptBox["10", 
                  RowBox[{"-", "6"}]]}]}], ",", 
               RowBox[{"{", 
                RowBox[{
                "kx", ",", "\[Kappa]r", ",", "a1", ",", "b1", ",", "b2", ",", 
                 "c1", ",", "c2"}], "}"}]}], "]"}], "]"}], ",", 
            SuperscriptBox["10", 
             RowBox[{"-", "6"}]]}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"len", "=", 
          RowBox[{"Length", "[", "sol", "]"}]}], ";", "\[IndentingNewLine]", 
