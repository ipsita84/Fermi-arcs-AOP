Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "daty0", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"daty0", "[", 
    RowBox[{"\[Mu]_", ",", "pts_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "\[Kappa]r", ",", "\[Kappa]i", ",", "ky", ",", "kz", ",", "eq0", ",", 
       "kx", ",", "eqn", ",", 
       RowBox[{"en", "=", "\[Mu]"}], ",", "a1", ",", 
       RowBox[{"a2", "=", "1.2"}], ",", "c1", ",", "c2", ",", "b1", ",", "b2",
        ",", 
       RowBox[{"del", "=", 
        RowBox[{"2", 
         RowBox[{"\[Pi]", "/", "pts"}]}]}], ",", "i", ",", "j", ",", 
       RowBox[{"dat", "=", 
        RowBox[{"{", "}"}]}], ",", "sol", ",", "len"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"eq0", "=", 
       RowBox[{
        SuperscriptBox["a1", "2"], "+", 
        SuperscriptBox["a2", "2"], "-", 
        SuperscriptBox["b1", "2"], "-", 
        SuperscriptBox["b2", "2"], "-", 
        RowBox[{"3", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "1"}], "+", 
           SuperscriptBox["c1", "2"], "+", 
           SuperscriptBox["c2", "2"]}], ")"}]}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"eqn", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"-", "2"}], " ", "en"}], "+", 
          RowBox[{
           SqrtBox["3"], " ", "a1", " ", "kx"}], "+", 
          RowBox[{
           SqrtBox["3"], " ", "a2", " ", "ky"}], "-", 
          RowBox[{"3", " ", "\[Kappa]i"}]}], ",", 
         RowBox[{
          RowBox[{
           SqrtBox["3"], " ", "a2", " ", "kx"}], "-", 
          RowBox[{
           SqrtBox["3"], " ", "a1", " ", "ky"}], "+", 
          RowBox[{"3", " ", "\[Kappa]r"}]}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             SqrtBox["3"], "+", 
             RowBox[{"2", " ", "b1"}]}], ")"}], " ", "kx"}], "+", 
          RowBox[{"2", " ", "b2", " ", "ky"}], "-", 
          RowBox[{"a1", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"2", " ", "en"}], "+", "\[Kappa]i"}], ")"}]}], "-", 
          RowBox[{"a2", " ", "\[Kappa]r"}]}], ",", 
         RowBox[{
          RowBox[{"2", " ", "b2", " ", "kx"}], "+", 
          RowBox[{
           SqrtBox["3"], " ", "ky"}], "-", 
          RowBox[{"2", " ", "b1", " ", "ky"}], "-", 
          RowBox[{"a2", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"2", " ", "en"}], "+", "\[Kappa]i"}], ")"}]}], "+", 
          RowBox[{"a1", " ", "\[Kappa]r"}]}], ",", 
