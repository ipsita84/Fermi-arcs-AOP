Cell[BoxData[{
 RowBox[{
  RowBox[{"lim", "=", "\[Pi]"}], ";", 
  RowBox[{"mu", "=", "1"}], ";", 
  RowBox[{"th", "=", "0.02"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"style", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Directive", "[", 
      RowBox[{
       RowBox[{"Darker", "[", "Cyan", "]"}], ",", 
       RowBox[{"Thickness", "[", "th", "]"}], ",", 
       RowBox[{"Opacity", "[", "0.75", "]"}]}], "]"}], ",", 
     RowBox[{"(*", "*)"}], 
     RowBox[{"Directive", "[", 
      RowBox[{"Orange", ",", 
       RowBox[{"Thickness", "[", "th", "]"}], ",", 
       RowBox[{"Opacity", "[", "0.75", "]"}]}], "]"}], ",", 
     RowBox[{"(*", "*)"}], 
     RowBox[{"Directive", "[", 
      RowBox[{
       RowBox[{"Darker", "[", "Blue", "]"}], ",", 
       RowBox[{"Thickness", "[", "th", "]"}], ",", 
       RowBox[{"Dashing", "[", "0.0025", "]"}]}], "]"}], ",", 
     RowBox[{"(*", "*)"}], 
     RowBox[{"Directive", "[", 
      RowBox[{
       RowBox[{"Darker", "[", "Green", "]"}], ",", 
       RowBox[{"Thickness", "[", "th", "]"}], ",", 
       RowBox[{"Dashing", "[", "0.0025", "]"}]}], "]"}]}], "}"}]}], ";", 
  RowBox[{"c2", "=", 
   RowBox[{
    RowBox[{"ContourPlot", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"kx", 
        FractionBox[
         RowBox[{" ", 
          RowBox[{
           SuperscriptBox["kx", "2"], "-", 
           RowBox[{"3", "  ", 
            SuperscriptBox["ky", "2"]}]}]}], 
         RowBox[{"2", " ", 
          RowBox[{"(", 
           RowBox[{
            SuperscriptBox["kx", "2"], "+", 
            SuperscriptBox["ky", "2"]}], ")"}]}]]}], "==", "mu"}], ",", 
      RowBox[{"{", 
       RowBox[{"kx", ",", 
        RowBox[{"-", "lim"}], ",", "lim"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"ky", ",", 
        RowBox[{"-", "lim"}], ",", "lim"}], "}"}], ",", 
      RowBox[{"ContourStyle", "->", 
       RowBox[{"style", "[", 
        RowBox[{"[", "4", "]"}], "]"}]}], ",", 
      RowBox[{"RegionFunction", "\[Rule]", 
       RowBox[{"Function", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"kx", ",", "ky", ",", "z"}], "}"}], ",", " ", 
