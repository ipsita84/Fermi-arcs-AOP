            RowBox[{"3", " ", 
             SuperscriptBox["kx", "2"], " ", "ky"}], "-", 
            RowBox[{"ky", " ", 
             SuperscriptBox["ky", "2"]}]}], ")"}], ">", "0"}]}], "  ", 
        "]"}]}]}], "]"}], "//", "Quiet"}]}], ";"}], "\[IndentingNewLine]", 
