Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"lim", "=", "\[Pi]"}], ";", 
  RowBox[{"mu", "=", "0.5"}], ";", 
  RowBox[{"th", "=", "0.007"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"style", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Directive", "[", 
      RowBox[{
       RowBox[{"Darker", "[", "Cyan", "]"}], ",", 
       RowBox[{"Thickness", "[", "th", "]"}], ",", 
       RowBox[{"Opacity", "[", "0.75", "]"}]}], "]"}], ",", 
     RowBox[{"(*", "*)"}], 
     RowBox[{"Directive", "[", 
      RowBox[{"Orange", ",", 
       RowBox[{"Thickness", "[", "th", "]"}], ",", 
       RowBox[{"Opacity", "[", "0.75", "]"}]}], "]"}], ",", 
     RowBox[{"(*", "*)"}], 
     RowBox[{"Directive", "[", 
      RowBox[{
       RowBox[{"Darker", "[", "Blue", "]"}], ",", 
       RowBox[{"Thickness", "[", "th", "]"}], ",", 
       RowBox[{"Dashing", "[", "0.0025", "]"}]}], "]"}], ",", 
     RowBox[{"(*", "*)"}], 
     RowBox[{"Directive", "[", 
      RowBox[{
       RowBox[{"Darker", "[", "Green", "]"}], ",", 
       RowBox[{"Thickness", "[", "th", "]"}], ",", 
       RowBox[{"Dashing", "[", "0.0025", "]"}]}], "]"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"c1", "=", 
   RowBox[{"Quiet", "[", 
    RowBox[{"ContourPlot", "[", 
     RowBox[{"(*", 
      RowBox[{"-", 
       FractionBox[
        RowBox[{"3", " ", "kx"}], "2"]}], "*)"}], 
     RowBox[{
      RowBox[{
       RowBox[{
        FractionBox["3", "2"], " ", 
        RowBox[{"(", "kx", ")"}]}], "==", "mu"}], ",", 
      RowBox[{"{", 
       RowBox[{"kx", ",", 
        RowBox[{"-", "lim"}], ",", "lim"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"ky", ",", 
        RowBox[{"-", "lim"}], ",", "lim"}], "}"}], ",", 
      RowBox[{"ContourStyle", "->", 
       RowBox[{"style", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], ",", 
      RowBox[{"RegionFunction", "\[Rule]", 
       RowBox[{"Function", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"kx", ",", "ky", ",", "z"}], "}"}], ",", 
         RowBox[{
          RowBox[{"Chop", "[", 
           RowBox[{"(*", 
            RowBox[{"-", "ky"}], "*)"}], "ky", "]"}], ">", "0"}]}], " ", 
        "]"}]}]}], "]"}], "]"}]}], ";", 
  RowBox[{"c2", "=", 
   RowBox[{
    RowBox[{"ContourPlot", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"kx", 
        FractionBox[
         RowBox[{" ", 
          RowBox[{
           SuperscriptBox["kx", "2"], "-", 
           RowBox[{"3", "  ", 
            SuperscriptBox["ky", "2"]}]}]}], 
         RowBox[{"2", " ", 
          RowBox[{"(", 
           RowBox[{
            SuperscriptBox["kx", "2"], "+", 
            SuperscriptBox["ky", "2"]}], ")"}]}]]}], "==", "mu"}], ",", 
      RowBox[{"{", 
       RowBox[{"kx", ",", 
        RowBox[{"-", "lim"}], ",", "lim"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"ky", ",", 
        RowBox[{"-", "lim"}], ",", "lim"}], "}"}], ",", 
      RowBox[{"ContourStyle", "->", 
       RowBox[{"style", "[", 
        RowBox[{"[", "4", "]"}], "]"}]}], ",", 
      RowBox[{"RegionFunction", "\[Rule]", 
       RowBox[{"Function", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"kx", ",", "ky", ",", "z"}], "}"}], ",", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"3", " ", 
             SuperscriptBox["kx", "2"], " ", "ky"}], "-", 
            RowBox[{"ky", " ", 
             SuperscriptBox["ky", "2"]}]}], ")"}], ">", "0"}]}], "  ", 
        "]"}]}]}], "]"}], "//", "Quiet"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fs", "=", 
   RowBox[{"ContourPlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        SqrtBox[
         RowBox[{
          SuperscriptBox["ky", "2"], "+", 
          SuperscriptBox["kx", "2"]}]], "==", 
        RowBox[{"2", "mu"}]}], ",", 
       RowBox[{
        SqrtBox[
         RowBox[{
          SuperscriptBox["ky", "2"], "+", 
          SuperscriptBox["kx", "2"]}]], "==", 
        RowBox[{"2", 
         RowBox[{"mu", "/", "3"}]}]}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"kx", ",", 
       RowBox[{"-", "lim"}], ",", "lim"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"ky", ",", 
       RowBox[{"-", "lim"}], ",", "lim"}], "}"}], ",", 
     RowBox[{"ContourStyle", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Directive", "[", 
         RowBox[{
          RowBox[{"Darker", "[", "Red", "]"}], ",", "Dashed"}], "]"}], ",", 
        RowBox[{"Directive", "[", 
         RowBox[{"Blue", ",", "Dashed"}], "]"}]}], "}"}]}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"plt", "=", 
  RowBox[{"Show", "[", 
   RowBox[{"c1", ",", "c2", ",", "fs", ",", 
    RowBox[{"Frame", "\[Rule]", "True"}], ",", 
    RowBox[{"Axes", "->", "False"}], ",", 
    RowBox[{"FrameTicksStyle", "\[Rule]", 
     RowBox[{"Directive", "[", 
      RowBox[{"Bold", ",", "Gray", ",", "16"}], "]"}]}], ",", 
    RowBox[{"LabelStyle", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"Black", ",", "Bold", ",", "22", ",", 
       RowBox[{"FontFamily", "\[Rule]", "\"\<TexMaths Symbols\>\""}]}], 
      "}"}]}], ",", 
    RowBox[{"FrameLabel", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"\"\<\!\(\*SubscriptBox[\(k\), \(x\)]\)\>\"", 
       ",", "\"\<\!\(\*SubscriptBox[\(k\), \(y\)]\)\>\""}], "}"}]}], ",", 
    RowBox[{"ImageSize", "\[Rule]", "450"}], ",", 
    RowBox[{"PlotLabel", "\[Rule]", 
     RowBox[{"Style", "[", 
      RowBox[{"(*", "***)"}], 
      RowBox[{"\"\<RSW node\>\"", ",", "20", ",", 
       RowBox[{"FontFamily", "->", "\"\<TexMaths Roman\>\""}], ",", "Brown", ",",
        "Bold"}], "]"}]}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SetDirectory", "[", 
   RowBox[{"NotebookDirectory", "[", "]"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Export", "[", 
   RowBox[{"\"\<RSWarc.pdf\>\"", ",", 
    RowBox[{"Rasterize", "[", "plt", "]"}], ",", 
    RowBox[{"ImageResolution", "->", "100"}]}], "]"}], ";"}]}], "Input",
