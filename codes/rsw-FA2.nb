          RowBox[{
           SqrtBox["3"], " ", "b1", " ", "ky"}], "+", 
          RowBox[{"3", " ", "c2", " ", "\[Kappa]i"}], "-", 
          RowBox[{"3", " ", "c1", " ", "\[Kappa]r"}]}]}], "}"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{"(*", "*)"}], 
       RowBox[{
