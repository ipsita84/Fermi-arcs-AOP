               RowBox[{
                RowBox[{"sol", "[", 
                 RowBox[{"[", 
                  RowBox[{"j", ",", "1"}], "]"}], "]"}], ",", "ky"}], "}"}]}],
              "]"}]}]}], 
          RowBox[{"(*", 
           RowBox[{";", " ", 
            RowBox[{"Print", "[", "\"\<***********\>\"", "]"}]}], "*)"}], 
          "]"}]}]}], "\[IndentingNewLine]", 
