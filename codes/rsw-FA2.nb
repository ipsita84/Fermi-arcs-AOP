Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"ener", ",", "kap"}], "}"}], "=", 
   RowBox[{"{", 
    RowBox[{
     FractionBox[
      RowBox[{"3", " ", "kx"}], "2"], ",", "ky"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Clear", "[", "bulkentry", "]"}], ";", 
  RowBox[{"bulkentry", "=", 
   RowBox[{"DeleteDuplicates", "[", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{
      RowBox[{"Solve", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"ky", "==", "0"}], " ", "&&", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"ky", "^", "2"}], "+", 
           SuperscriptBox["kx", "2"]}], " ", "==", 
          RowBox[{"4", 
           RowBox[{
            RowBox[{"\[Mu]", "^", "2"}], "/", "9"}]}]}]}], ",", 
        RowBox[{"{", 
         RowBox[{"kx", ",", "ky"}], "}"}]}], "]"}], ",", "ass"}], "]"}], 
    "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{"grad", "=", 
  RowBox[{"Simplify", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Grad", "[", " ", 
      RowBox[{"ener", ",", 
       RowBox[{"{", 
        RowBox[{"kx", ",", "ky"}], "}"}]}], "]"}], "/.", "bulkentry"}], ",", 
    "ass"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"tang1", "=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"grad", "[", 
     RowBox[{"[", 
      RowBox[{"1", ",", "2"}], "]"}], "]"}], ",", 
    RowBox[{"-", 
     RowBox[{"grad", "[", 
      RowBox[{"[", 
       RowBox[{"1", ",", "1"}], "]"}], "]"}]}]}], "}"}]}], "\[IndentingNewLine]", 
