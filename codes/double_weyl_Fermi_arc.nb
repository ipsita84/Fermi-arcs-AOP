Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"ans", "=", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"en", "->", 
       FractionBox[
        SqrtBox[
         RowBox[{
          RowBox[{
           SuperscriptBox["kz", "2"], " ", 
           SuperscriptBox[
            RowBox[{"Cos", "[", "t", "]"}], "2"]}], "-", 
          RowBox[{"4", " ", 
           SuperscriptBox["ky", "4"], " ", 
           SuperscriptBox[
            RowBox[{"Tan", "[", "t", "]"}], "2"]}]}]], 
        RowBox[{"Cos", "[", "t", "]"}]]}], ",", 
      RowBox[{"a1", "->", 
       RowBox[{"a", " ", 
        RowBox[{"Cos", "[", "t", "]"}]}]}], ",", 
      RowBox[{"b1", "->", 
       RowBox[{"a", " ", 
        RowBox[{"Sin", "[", "t", "]"}]}]}], ",", " ", 
      RowBox[{"\[Kappa]r", "\[Rule]", 
       RowBox[{"sgn", 
        FractionBox["ky", 
         RowBox[{"Cos", "[", "t", "]"}]]}]}], ",", " ", 
      RowBox[{"a", "\[Rule]", 
       RowBox[{"sgn", 
        FractionBox[
         RowBox[{
          RowBox[{"kz", " ", 
           RowBox[{"Cos", "[", "t", "]"}]}], "-", 
          SqrtBox[
           RowBox[{
            RowBox[{
             SuperscriptBox["kz", "2"], " ", 
             SuperscriptBox[
              RowBox[{"Cos", "[", "t", "]"}], "2"]}], "-", 
            RowBox[{"4", " ", 
             SuperscriptBox["ky", "4"], " ", 
             SuperscriptBox[
              RowBox[{"Tan", "[", "t", "]"}], "2"]}]}]]}], 
         RowBox[{"2", " ", 
          SuperscriptBox["ky", "2"], " ", 
          RowBox[{"(", 
           RowBox[{"1", "+", 
            FractionBox["1", 
             RowBox[{"Cos", "[", "t", "]"}]]}], ")"}]}]]}]}]}], "}"}], "/.", 
    "rep"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.96992105885282*^9, 3.969921064163424*^9}, {
   3.969921094306736*^9, 3.9699211879929323`*^9}, {3.969921540228388*^9, 
