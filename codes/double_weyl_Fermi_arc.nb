      SubscriptBox["v", "z"]}], ",", " ", 
     RowBox[{"vp", "->", 
      SubscriptBox["v", "p"]}], ",", 
     RowBox[{"en", "->", "e"}], ",", 
     RowBox[{"b1", "->", 
      SubscriptBox["b", "1"]}], ",", 
     RowBox[{"b2", "->", 
      SubscriptBox["b", "2"]}], ",", 
     RowBox[{"b3", "->", 
      SubscriptBox["b", "3"]}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ass", "=", 
