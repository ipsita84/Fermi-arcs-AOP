    RowBox[{"1", ",", 
     RowBox[{"a1", "-", 
      RowBox[{"\[ImaginaryI]", " ", "b1"}]}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"prod", "=", 
