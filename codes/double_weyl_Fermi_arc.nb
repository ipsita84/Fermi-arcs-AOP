Cell[BoxData[{
 RowBox[{
  RowBox[{"mu", "=", "0.25"}], ";", 
  RowBox[{"lim", "=", "\[Pi]"}], ";", 
  RowBox[{"t", "=", "50"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"c1", "=", 
   RowBox[{
    RowBox[{"ContourPlot", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"kz", 
        FractionBox[
         SqrtBox[
          RowBox[{" ", 
           RowBox[{
            SuperscriptBox[
             RowBox[{"Cos", "[", "t", "]"}], "2"], "-", 
            RowBox[{"4", " ", 
             SuperscriptBox["ky", "4"], " ", 
             RowBox[{
              SuperscriptBox[
               RowBox[{"Tan", "[", "t", "]"}], "2"], "/", 
              SuperscriptBox["kz", "2"]}]}]}]}]], 
         RowBox[{"Cos", "[", "t", "]"}]]}], "==", "mu"}], ",", 
      RowBox[{"{", 
       RowBox[{"ky", ",", 
        RowBox[{"-", "lim"}], ",", "lim"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"kz", ",", 
        RowBox[{"-", "lim"}], ",", "lim"}], "}"}], ",", 
      RowBox[{"FrameLabel", "->", 
       RowBox[{"{", 
        RowBox[{"ky", ",", "kz"}], "}"}]}], ",", 
      RowBox[{"ContourStyle", "->", "Red"}], ",", " ", 
      RowBox[{"PlotLegends", "->", "Automatic"}], ",", 
      RowBox[{"RegionFunction", "\[Rule]", 
       RowBox[{"Function", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"ky", ",", "kz", ",", "z"}], "}"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{
             SuperscriptBox["kz", "2"], " ", 
             SuperscriptBox[
              RowBox[{"Cos", "[", "t", "]"}], "2"]}], "-", 
            RowBox[{"4", " ", 
             SuperscriptBox["ky", "4"], " ", 
             SuperscriptBox[
              RowBox[{"Tan", "[", "t", "]"}], "2"]}]}], ">=", "0"}], " ", "&&",
           " ", 
          RowBox[{
           FractionBox[
            RowBox[{"-", "ky"}], 
            RowBox[{"Cos", "[", "t", "]"}]], ">", "0"}]}]}], "]"}]}]}], "]"}],
     "//", "Quiet"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"c2", "=", 
    RowBox[{
     RowBox[{"ContourPlot", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"-", "kz"}], 
         FractionBox[
          SqrtBox[
           RowBox[{" ", 
            RowBox[{
             SuperscriptBox[
              RowBox[{"Cos", "[", "t", "]"}], "2"], "-", 
             RowBox[{"4", " ", 
              SuperscriptBox["ky", "4"], " ", 
              RowBox[{
               SuperscriptBox[
                RowBox[{"Tan", "[", "t", "]"}], "2"], "/", 
               SuperscriptBox["kz", "2"]}]}]}]}]], 
          RowBox[{"Cos", "[", "t", "]"}]]}], "==", "mu"}], ",", 
       RowBox[{"{", 
        RowBox[{"ky", ",", 
         RowBox[{"-", "lim"}], ",", "lim"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"kz", ",", 
         RowBox[{"-", "lim"}], ",", "lim"}], "}"}], ",", 
       RowBox[{"FrameLabel", "->", 
        RowBox[{"{", 
         RowBox[{"ky", ",", "kz"}], "}"}]}], ",", 
       RowBox[{"ContourStyle", "->", "Red"}], ",", " ", 
       RowBox[{"PlotLegends", "->", "Automatic"}], ",", 
       RowBox[{"RegionFunction", "\[Rule]", 
        RowBox[{"Function", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"ky", ",", "kz", ",", "z"}], "}"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{
              SuperscriptBox["kz", "2"], " ", 
              SuperscriptBox[
               RowBox[{"Cos", "[", "t", "]"}], "2"]}], "-", 
             RowBox[{"4", " ", 
              SuperscriptBox["ky", "4"], " ", 
              SuperscriptBox[
               RowBox[{"Tan", "[", "t", "]"}], "2"]}]}], ">=", "0"}], " ", "&&",
            " ", 
           RowBox[{
            FractionBox[
             RowBox[{"-", "ky"}], 
             RowBox[{"Cos", "[", "t", "]"}]], ">", "0"}]}]}], "]"}]}]}], 
      "]"}], "//", "Quiet"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fs", "=", 
   RowBox[{"ContourPlot", "[", 
    RowBox[{
     RowBox[{
      SqrtBox[
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          SuperscriptBox["ky", "2"], ")"}], "2"], "+", 
        SuperscriptBox[
         RowBox[{"(", "kz", ")"}], "2"]}]], "==", "mu"}], ",", 
     RowBox[{"{", 
