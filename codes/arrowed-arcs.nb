           RowBox[{
            RowBox[{"Flatten", "[", 
             RowBox[{"{", 
              RowBox[{"#1", ",", "#2"}], "}"}], "]"}], "&"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Table", "[", 
              RowBox[{"#1", ",", 
               RowBox[{"{", "#2", "}"}]}], "]"}], ",", "#3"}], "}"}]}], "]"}],
          "&"}], ",", 
        RowBox[{"{", 
         RowBox[{"defaultstyles", ",", "lengths", ",", "userstyles"}], 
         "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"newstyles", "=", 
      RowBox[{"MapThread", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Join", "[", 
          RowBox[{
           RowBox[{"Flatten", "[", 
            RowBox[{
             RowBox[{"Table", "[", 
              RowBox[{"#1", ",", 
               RowBox[{"{", 
                RowBox[{"Floor", "[", 
                 RowBox[{"#2", "/", "#3"}], "]"}], "}"}]}], "]"}], ",", "1"}],
             "]"}], ",", 
           RowBox[{"Take", "[", 
            RowBox[{"#1", ",", 
             RowBox[{"Mod", "[", 
              RowBox[{"#2", ",", "#3"}], "]"}]}], "]"}]}], "]"}], "&"}], ",", 
        
        RowBox[{"{", 
         RowBox[{"newstyles", ",", "numbers", ",", "lengths"}], "}"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"temp", "=", 
         RowBox[{"DeleteCases", "[", 
          RowBox[{"newstyles", ",", "Automatic", ",", "Infinity"}], "]"}]}], 
        "}"}], ",", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", 
           RowBox[{"{", "options", "}"}], "]"}], "===", "1"}], ",", 
         RowBox[{"First", "[", "temp", "]"}], ",", "temp"}], "]"}]}], 
      "]"}]}]}], "]"}]}], "\n"}], "Input",
 InitializationCell->True,
 CellEventActions->{Inherited, {"KeyDown", "\t"} :> Replace[SelectionMove[
