Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"DirectionParametricPlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     SubscriptBox[
      StyleBox["f", "TI"], 
      StyleBox["x", "TI"]], ",", 
     SubscriptBox[
      StyleBox["f", "TI"], 
      StyleBox["y", "TI"]]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["t", "TI"], ",", 
     SubscriptBox[
      StyleBox["t", "TI"], 
      StyleBox["min", "TI"]], ",", 
     SubscriptBox[
      StyleBox["t", "TI"], 
      StyleBox["max", "TI"]]}], "}"}]}], "]"}]], "UsageInputs",
 FontFamily->"Source Sans Pro",
 CellID->849516747,ExpressionUUID->"b50e5318-54dc-4d9b-8492-7eb1004656eb"],

Cell[TextData[{
 "generates a parametric plot of a curve ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    SubscriptBox[
     StyleBox["f", "TI"], 
     StyleBox["x", "TI"]], ",", 
    SubscriptBox[
     StyleBox["f", "TI"], 
     StyleBox["y", "TI"]]}], "}"}]],ExpressionUUID->
  "b8dba96f-2ded-41e5-a144-25f8349301a7"],
 " whose ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "71704a89-29ed-4c81-8da1-647d0d906d1b"],
 "- and ",
 Cell[BoxData[
  StyleBox["y", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "c7594305-4e87-47c7-b4a6-28cf490cd1dc"],
 "-coordinates ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["f", "TI"], 
   StyleBox["x", "TI"]]],ExpressionUUID->
  "6b1479c6-f533-462b-9d83-14e047433b31"],
 " and ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["f", "TI"], 
   StyleBox["y", "TI"]]],ExpressionUUID->
  "6ec77177-9798-4aee-a60a-1da0440d3269"],
 " are functions of ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "64495c8f-0b89-4beb-b52f-b8e4e706c159"],
 " and with the direction of the curve indicated by color and arrowheads."
}], "UsageDescription",
 CellID->924938464,ExpressionUUID->"71fecdbc-6a14-46c1-aca9-1bbd79174766"]
}, Open  ]]
}, Open  ]],

