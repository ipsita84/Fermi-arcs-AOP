Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"eqn", ",", "soll", ",", "soln", ",", "ener"}], "]"}], ";", 
  RowBox[{"eqn", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"-", "2"}], " ", "en"}], "+", 
        RowBox[{
         SqrtBox["3"], " ", "a1", " ", "kx"}], "+", 
        RowBox[{
         SqrtBox["3"], " ", "b1", " ", "ky"}], "-", 
        RowBox[{"3", " ", "\[Kappa]i"}]}], ",", 
       RowBox[{
        RowBox[{
         SqrtBox["3"], " ", "b1", " ", "kx"}], "-", 
        RowBox[{
         SqrtBox["3"], " ", "a1", " ", "ky"}], "+", 
        RowBox[{"3", " ", "\[Kappa]r"}]}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           SqrtBox["3"], "+", 
           RowBox[{"2", " ", "a2"}]}], ")"}], " ", "kx"}], "+", 
        RowBox[{"2", " ", "b2", " ", "ky"}], "-", 
        RowBox[{"a1", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"2", " ", "en"}], "+", "\[Kappa]i"}], ")"}]}], "-", 
        RowBox[{"b1", " ", "\[Kappa]r"}]}], ",", 
       RowBox[{
        RowBox[{"2", " ", "b2", " ", "kx"}], "+", 
