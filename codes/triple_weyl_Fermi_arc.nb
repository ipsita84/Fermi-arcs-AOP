Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"mu", "=", "0.5"}], ";", 
  RowBox[{"lim", "=", "\[Pi]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"xdat", "=", 
   RowBox[{"data", "[", 
    RowBox[{"6", ",", "mu", ",", "50"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"c1", "=", 
   RowBox[{"ListPlot", "[", 
    RowBox[{"xdat", ",", 
     RowBox[{"PlotRange", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "\[Pi]"}], ",", "\[Pi]"}], "}"}]}], ",", 
     RowBox[{"Frame", "->", "True"}], ",", 
     RowBox[{"PlotStyle", "->", "Red"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fs", "=", 
   RowBox[{"ContourPlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       SqrtBox[
        RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
           SuperscriptBox["ky", "2"], ")"}], "3"], "+", 
         SuperscriptBox["kz", "2"]}]], "==", "mu"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"ky", ",", 
       RowBox[{"-", "lim"}], ",", "lim"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"kz", ",", 
       RowBox[{"-", "lim"}], ",", "lim"}], "}"}], ",", 
     RowBox[{"FrameLabel", "->", 
      RowBox[{"{", 
       RowBox[{"ky", ",", "kz"}], "}"}]}], ",", 
     RowBox[{"Contours", "->", "20"}], ",", 
     RowBox[{"PlotLegends", "->", "Automatic"}], ",", 
     RowBox[{"ContourStyle", "->", "Blue"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"c1", ",", "fs"}], "}"}], ",", 
   RowBox[{"FrameLabel", "->", 
    RowBox[{"{", 
     RowBox[{"ky", ",", "kz"}], "}"}]}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Clear", "[", "\[Mu]", "]"}]}], "Input",
