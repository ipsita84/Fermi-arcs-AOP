Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"xdat", ",", "c1", ",", "fs"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"mu", "=", "0.5"}], ";", 
  RowBox[{"lim", "=", "\[Pi]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"xdat", "=", 
   RowBox[{"data", "[", 
    RowBox[{
     RowBox[{"Tan", "[", 
      RowBox[{
       RowBox[{"\[Pi]", "/", "2"}], "-", "0.2"}], "]"}], ",", "mu", ",", 
     "70"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"c1", "=", 
   RowBox[{"ListPlot", "[", 
    RowBox[{"xdat", ",", 
     RowBox[{"PlotRange", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "\[Pi]"}], ",", "\[Pi]"}], "}"}]}], ",", 
     RowBox[{"Frame", "->", "True"}], ",", 
     RowBox[{"PlotStyle", "->", "Red"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fs", "=", 
   RowBox[{"ContourPlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       SqrtBox[
        RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
           SuperscriptBox["ky", "2"], ")"}], "3"], "+", 
         SuperscriptBox["kz", "2"]}]], "==", "mu"}], "}"}], ",", 
