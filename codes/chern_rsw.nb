Notebook[{
Cell[BoxData[{
 RowBox[{
  RowBox[{"$PrePrint", "=", 
   RowBox[{
    RowBox[{"#", "/.", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"Csc", "[", "z_", "]"}], ":>", 
        RowBox[{"1", "/", 
         RowBox[{"Defer", "@", 
          RowBox[{"Sin", "[", "z", "]"}]}]}]}], ",", 
       RowBox[{
        RowBox[{"Sec", "[", "z_", "]"}], ":>", 
        RowBox[{"1", "/", 
         RowBox[{"Defer", "@", 
          RowBox[{"Cos", "[", "z", "]"}]}]}]}]}], "}"}]}], "&"}]}], ";", 
  RowBox[{"rep", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"kx", "\[Rule]", " ", 
      RowBox[{"k", " ", 
       RowBox[{"Sin", "[", "\[Theta]", "]"}], " ", 
       RowBox[{"Cos", "[", "\[Phi]", "]"}]}]}], ",", 
     RowBox[{"ky", "\[Rule]", " ", 
      RowBox[{"k", " ", 
       RowBox[{"Sin", "[", "\[Theta]", "]"}], 
       RowBox[{"Sin", "[", "\[Phi]", "]"}]}]}], ",", 
     RowBox[{"kp", "\[Rule]", " ", 
      RowBox[{"k", " ", 
       RowBox[{"Sin", "[", "\[Theta]", "]"}]}]}], ",", 
     RowBox[{"kz", "\[Rule]", " ", 
      RowBox[{"k", " ", 
       RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ass", "=", 
   RowBox[{"Assumptions", "->", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "ky", ",", "kz", ",", "\[Kappa]i", ",", "\[Kappa]r", ",", "\[Theta]", ",",
         "\[Phi]", ",", "\[Alpha]", ",", "en", ",", "a1", ",", "a2", ",", 
        "b1", ",", "b3", ",", "c1", ",", "c2"}], "}"}], "\[Element]", " ", 
      "Reals"}], " ", "&&", "  ", 
     RowBox[{"k", ">", "0"}], "  ", "&&", " ", 
     RowBox[{"v", ">", "0"}], " ", "&&", " ", 
     RowBox[{"vz", ">", "0"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"jx", "=", 
   RowBox[{"(", GridBox[{
      {"0", 
       FractionBox[
        SqrtBox["3"], "2"], "0", "0"},
      {
       FractionBox[
        SqrtBox["3"], "2"], "0", "1", "0"},
      {"0", "1", "0", 
       FractionBox[
        SqrtBox["3"], "2"]},
      {"0", "0", 
       FractionBox[
        SqrtBox["3"], "2"], "0"}
     }], ")"}]}], ";", 
  RowBox[{"jy", "=", " ", 
   RowBox[{"(", GridBox[{
      {"0", 
       RowBox[{
        RowBox[{"-", 
         FractionBox[
          SqrtBox["3"], "2"]}], "\[ImaginaryI]"}], "0", "0"},
      {
       RowBox[{
        FractionBox[
         SqrtBox["3"], "2"], "\[ImaginaryI]"}], "0", 
       RowBox[{"-", "\[ImaginaryI]"}], "0"},
      {"0", "\[ImaginaryI]", "0", 
       RowBox[{
        RowBox[{"-", 
         FractionBox[
          SqrtBox["3"], "2"]}], "\[ImaginaryI]"}]},
      {"0", "0", 
       RowBox[{
        FractionBox[
         SqrtBox["3"], "2"], "\[ImaginaryI]"}], "0"}
     }], ")"}]}], " ", ";", " ", 
  RowBox[{"jz", "=", " ", 
   RowBox[{"(", GridBox[{
      {
       FractionBox["3", "2"], "0", "0", "0"},
      {"0", 
       FractionBox["1", "2"], "0", "0"},
      {"0", "0", 
       RowBox[{"-", 
        FractionBox["1", "2"]}], "0"},
      {"0", "0", "0", 
       RowBox[{"-", 
        FractionBox["3", "2"]}]}
     }], ")"}]}], " ", ";", 
  RowBox[{"id", "=", 
   RowBox[{"IdentityMatrix", "[", "4", "]"}]}], ";", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"dx", ",", "dy", ",", "dz"}], "}"}], "=", 
   RowBox[{"{", 
    RowBox[{"kx", ",", " ", "ky", ",", "kz"}], "}"}]}], ";"}]}], "Input",
 InitializationCell->True,
