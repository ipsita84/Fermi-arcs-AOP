Cell[BoxData[{
 RowBox[{
  RowBox[{"v1", "=", 
   RowBox[{"{", 
    RowBox[{"1", ",", 
     FractionBox[
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{"\[ImaginaryI]", " ", "\[Alpha]"}]], 
      SqrtBox["3"]], ",", 
     FractionBox[
      RowBox[{"4", "+", 
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{"2", " ", "\[ImaginaryI]", " ", "\[Alpha]"}]], "-", 
       FractionBox[
        RowBox[{"8", " ", "kx"}], 
        RowBox[{"kx", "-", 
         RowBox[{"\[ImaginaryI]", " ", "ky"}]}]]}], 
      RowBox[{"3", " ", 
       SqrtBox["3"]}]], ",", 
     FractionBox[
      RowBox[{
       RowBox[{
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"3", " ", "\[ImaginaryI]", " ", "\[Alpha]"}]], " ", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"kx", "-", 
           RowBox[{"\[ImaginaryI]", " ", "ky"}]}], ")"}], "2"]}], "-", 
       RowBox[{"8", " ", 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{
          RowBox[{"-", "\[ImaginaryI]"}], " ", "\[Alpha]"}]], " ", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"kx", "+", 
           RowBox[{"\[ImaginaryI]", " ", "ky"}]}], ")"}], "2"]}], "-", 
       RowBox[{"20", " ", 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"\[ImaginaryI]", " ", "\[Alpha]"}]], " ", 
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox["kx", "2"], "+", 
          SuperscriptBox["ky", "2"]}], ")"}]}]}], 
      RowBox[{"27", " ", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"kx", "-", 
          RowBox[{"\[ImaginaryI]", " ", "ky"}]}], ")"}], "2"]}]]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"v1c", "=", 
   RowBox[{"{", 
    RowBox[{"1", ",", 
     FractionBox[
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{
        RowBox[{"-", "\[ImaginaryI]"}], " ", "\[Alpha]"}]], 
      SqrtBox["3"]], ",", 
     FractionBox[
      RowBox[{"4", "+", 
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{
         RowBox[{"-", "2"}], " ", "\[ImaginaryI]", " ", "\[Alpha]"}]], "-", 
       FractionBox[
        RowBox[{"8", " ", "kx"}], 
        RowBox[{"kx", "+", 
         RowBox[{"\[ImaginaryI]", " ", "ky"}]}]]}], 
      RowBox[{"3", " ", 
       SqrtBox["3"]}]], ",", 
     FractionBox[
      RowBox[{
       RowBox[{
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{
          RowBox[{"-", "3"}], " ", "\[ImaginaryI]", " ", "\[Alpha]"}]], " ", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"kx", "+", 
           RowBox[{"\[ImaginaryI]", " ", "ky"}]}], ")"}], "2"]}], "-", 
       RowBox[{"8", " ", 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"\[ImaginaryI]", " ", "\[Alpha]"}]], " ", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"kx", "-", 
           RowBox[{"\[ImaginaryI]", " ", "ky"}]}], ")"}], "2"]}], "-", 
       RowBox[{"20", " ", 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{
          RowBox[{"-", "\[ImaginaryI]"}], " ", "\[Alpha]"}]], " ", 
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox["kx", "2"], "+", 
          SuperscriptBox["ky", "2"]}], ")"}]}]}], 
      RowBox[{"27", " ", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"kx", "+", 
          RowBox[{"\[ImaginaryI]", " ", "ky"}]}], ")"}], "2"]}]]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"normsq1", "=", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{
      RowBox[{"v1c", ".", "v1"}], ",", 
      RowBox[{"Assumptions", "\[Rule]", "ass"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Psi]1dag", "=", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{"v1c", "/", 
      SqrtBox["normsq1"]}], ",", 
     RowBox[{"Assumptions", "\[Rule]", "ass"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Psi]1", "=", 
