Cell[BoxData[
 RowBox[{"vec1", "=", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"\[ImaginaryI]", "+", 
          SqrtBox["3"]}], ")"}], " ", 
        SuperscriptBox["kx", "2"]}], "-", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "\[ImaginaryI]"}], "+", 
          SqrtBox["3"]}], ")"}], " ", 
        SuperscriptBox["ky", "2"]}], "-", 
       RowBox[{"2", " ", "\[ImaginaryI]", " ", 
        SuperscriptBox["kz", "2"]}]}], ")"}], 
     RowBox[{"{", 
      RowBox[{
       FractionBox[
        RowBox[{"2", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            SqrtBox["3"], " ", "kx", " ", "ky", " ", "kz"}], "+", "en"}], 
          ")"}]}], 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"\[ImaginaryI]", "+", 
            SqrtBox["3"]}], ")"}], " ", 
          SuperscriptBox["kx", "2"]}], "-", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "\[ImaginaryI]"}], "+", 
            SqrtBox["3"]}], ")"}], " ", 
          SuperscriptBox["ky", "2"]}], "-", 
         RowBox[{"2", " ", "\[ImaginaryI]", " ", 
          SuperscriptBox["kz", "2"]}]}]], ",", "1"}], "}"}]}], "/.", 
    RowBox[{"kx", "->", 
     RowBox[{"\[ImaginaryI]", 
      RowBox[{"(", 
       RowBox[{"\[Kappa]r", "+", 
        RowBox[{"\[ImaginaryI]", " ", "\[Kappa]i"}]}], ")"}]}]}]}], "//", 
   "FullSimplify"}]}]], "Input",
