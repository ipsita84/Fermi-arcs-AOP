Cell[BoxData[{
 RowBox[{
  RowBox[{"$PrePrint", "=", 
   RowBox[{
    RowBox[{"#", "/.", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"Csc", "[", "z_", "]"}], ":>", 
        RowBox[{"1", "/", 
         RowBox[{"Defer", "@", 
          RowBox[{"Sin", "[", "z", "]"}]}]}]}], ",", 
       RowBox[{
        RowBox[{"Sec", "[", "z_", "]"}], ":>", 
        RowBox[{"1", "/", 
         RowBox[{"Defer", "@", 
          RowBox[{"Cos", "[", "z", "]"}]}]}]}]}], "}"}]}], "&"}]}], ";", 
  RowBox[{"rep", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"kx", "\[Rule]", " ", 
      RowBox[{"k", " ", 
       RowBox[{"Sin", "[", "\[Theta]", "]"}], " ", 
       RowBox[{"Cos", "[", "\[Phi]", "]"}]}]}], ",", 
     RowBox[{"ky", "\[Rule]", " ", 
      RowBox[{"k", " ", 
       RowBox[{"Sin", "[", "\[Theta]", "]"}], 
       RowBox[{"Sin", "[", "\[Phi]", "]"}]}]}], ",", 
     RowBox[{"kp", "\[Rule]", " ", 
      RowBox[{"k", " ", 
       RowBox[{"Sin", "[", "\[Theta]", "]"}]}]}], ",", 
     RowBox[{"kz", "\[Rule]", " ", 
      RowBox[{"k", " ", 
       RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}], ",", " ", 
     RowBox[{
      SuperscriptBox["\[Xi]", "2"], "->", "1"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ass", "=", 
   RowBox[{"Assumptions", "->", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "en", ",", "k", ",", "\[Theta]", ",", "\[Phi]", ",", "kx", ",", "ky", ",",
         "kz", ",", "\[Kappa]r", ",", "\[Kappa]i", ",", "kw", ",", "k1", ",", 
        "k2"}], "}"}], "\[Element]", " ", "Reals"}], " ", "&&", "  ", 
     RowBox[{"k", ">", "0"}], " ", "&&", " ", 
     RowBox[{"kp", ">", "0"}], " ", "&&", " ", 
     RowBox[{"en", ">=", "0"}], " ", "&&", " ", 
